{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "PipelineStartTime",
          "value": {
            "value": "@utcNow()",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set Pipeline Start Time",
        "dependsOn": []
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderStoredProcedureName": "spGet_Bronze_Batch",
            "storedProcedureParameters": {
              "TriggerName": {
                "value": {
                  "value": "@pipeline().parameters.TriggerName",
                  "type": "Expression"
                },
                "type": "String"
              }
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "IngestXcel",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "a7797e2d-0b78-b1bc-4619-19ad5a9b3e80",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "externalReferences": {
                  "connection": "5dc75a5f-3c6d-4cb4-a905-a8c7540e5e89"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Get Bronze Batch",
        "dependsOn": [
          {
            "activity": "Set Pipeline Start Time",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('Get Bronze Batch').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "EXEC [DBO].[spStart_Ingestion_Log]\n    @META_ORCHESTRATION_ID = @META_ORCHESTRATION_ID,\n    @TriggerExecutionId = @TriggerExecutionId,\n    @TriggerExecutionStartTime = @TriggerExecutionStartTime,\n    @META_INGESTION_LOG_ID = @META_INGESTION_LOG_ID OUTPUT",
                      "type": "Expression"
                    },
                    "type": "NonQuery",
                    "parameters": [
                      {
                        "name": "META_ORCHESTRATION_ID",
                        "type": "Int32",
                        "value": {
                          "value": "@item().META_ORCHESTRATION_ID",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "TriggerExecutionId",
                        "type": "String",
                        "value": {
                          "value": "@pipeline().RunId",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "TriggerExecutionStartTime",
                        "type": "String",
                        "value": {
                          "value": "@variables('PipelineStartTime')",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "META_INGESTION_LOG_ID",
                        "type": "Int64",
                        "direction": "Output"
                      }
                    ]
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "connectionSettings": {
                "name": "IngestXcel",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "a7797e2d-0b78-b1bc-4619-19ad5a9b3e80",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "5dc75a5f-3c6d-4cb4-a905-a8c7540e5e89"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Start Log",
              "dependsOn": []
            },
            {
              "type": "IfCondition",
              "typeProperties": {
                "expression": {
                  "value": "@equals(item().PROCESSING_METHOD, 'INCREMENTAL')",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "type": "Lookup",
                    "typeProperties": {
                      "source": {
                        "type": "FabricSqlDatabaseSource",
                        "sqlReaderStoredProcedureName": "spGet_Last_Watermark",
                        "storedProcedureParameters": {
                          "META_ORCHESTRATION_ID": {
                            "value": {
                              "value": "@item().META_ORCHESTRATION_ID",
                              "type": "Expression"
                            },
                            "type": "Int32"
                          }
                        },
                        "partitionOption": "None",
                        "queryTimeout": "02:00:00"
                      },
                      "datasetSettings": {
                        "type": "FabricSqlDatabaseTable",
                        "schema": [],
                        "connectionSettings": {
                          "name": "IngestXcel",
                          "properties": {
                            "type": "FabricSqlDatabase",
                            "typeProperties": {
                              "artifactId": "a7797e2d-0b78-b1bc-4619-19ad5a9b3e80",
                              "workspaceId": "00000000-0000-0000-0000-000000000000"
                            },
                            "externalReferences": {
                              "connection": "5dc75a5f-3c6d-4cb4-a905-a8c7540e5e89"
                            },
                            "annotations": []
                          }
                        },
                        "annotations": []
                      }
                    },
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureInput": false,
                      "secureOutput": false
                    },
                    "name": "Get Last Watermark",
                    "dependsOn": []
                  },
                  {
                    "type": "SetVariable",
                    "typeProperties": {
                      "variableName": "v_WatermarkUsed",
                      "value": "@activity('Get Last Watermark').output.firstRow.WATERMARK_VALUE"
                    },
                    "policy": {
                      "secureInput": false,
                      "secureOutput": false
                    },
                    "name": "Capture Watermark",
                    "dependsOn": [
                      {
                        "activity": "Get Last Watermark",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ]
                  }
                ],
                "ifFalseActivities": []
              },
              "name": "Check Processing Method",
              "dependsOn": [
                {
                  "activity": "Reset Watermark Used",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Switch",
              "typeProperties": {
                "on": {
                  "value": "@item().SOURCE_TECH_TYPE",
                  "type": "Expression"
                },
                "cases": [
                  {
                    "value": "FABRIC_SQLDB",
                    "activities": [
                      {
                        "type": "Copy",
                        "typeProperties": {
                          "source": {
                            "type": "FabricSqlDatabaseSource",
                            "sqlReaderQuery": {
                              "value": "@if(\n  equals(item().PROCESSING_METHOD, 'INCREMENTAL'),\n  concat('SELECT * FROM ', item().SOURCE_ENTITY_NAME, ' WHERE ', item().WATERMARK_COLUMN, ' > ''', activity('Get Last Watermark').output.firstRow.WATERMARK_VALUE, ''''),\n  concat('SELECT * FROM ', item().SOURCE_ENTITY_NAME)\n)",
                              "type": "Expression"
                            },
                            "partitionOption": "None",
                            "queryTimeout": "02:00:00",
                            "datasetSettings": {
                              "type": "FabricSqlDatabaseTable",
                              "schema": [],
                              "connectionSettings": {
                                "name": "ef1455fd_dfce_483d_bd7c_ba703c2ba427",
                                "properties": {
                                  "type": "FabricSqlDatabase",
                                  "typeProperties": {
                                    "artifactId": "@item().SOURCE_SQLDATABASE_ID",
                                    "workspaceId": "@item().SOURCE_WORKSPACE_ID"
                                  },
                                  "externalReferences": {
                                    "connection": "@item().SOURCE_FABRIC_CONNECTION_ID"
                                  },
                                  "annotations": []
                                }
                              },
                              "annotations": []
                            }
                          },
                          "sink": {
                            "type": "LakehouseTableSink",
                            "tableActionOption": "Append",
                            "applyVOrder": false,
                            "datasetSettings": {
                              "type": "LakehouseTable",
                              "typeProperties": {
                                "schema": {
                                  "value": "@item().TARGET_SCHEMA_NAME",
                                  "type": "Expression"
                                },
                                "table": {
                                  "value": "@item().TARGET_ENTITY",
                                  "type": "Expression"
                                }
                              },
                              "schema": [],
                              "connectionSettings": {
                                "name": "358af9fb_10c1_43c2_a3ac_2e0c87660b11",
                                "properties": {
                                  "type": "Lakehouse",
                                  "typeProperties": {
                                    "artifactId": "@item().TARGET_LAKEHOUSE_ID",
                                    "workspaceId": "@item().TARGET_WORKSPACE_ID",
                                    "rootFolder": "Tables"
                                  },
                                  "externalReferences": {
                                    "connection": "9e4d6035-ac17-4eb8-8421-5e38a92a1dfc"
                                  },
                                  "annotations": []
                                }
                              },
                              "annotations": []
                            }
                          },
                          "translator": {
                            "type": "TabularTranslator",
                            "typeConversion": true,
                            "typeConversionSettings": {
                              "allowDataTruncation": true,
                              "treatBooleanAsNumber": false
                            }
                          },
                          "enableStaging": false
                        },
                        "policy": {
                          "timeout": "0.12:00:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureInput": false,
                          "secureOutput": false
                        },
                        "name": "Copy Fabric SQLDB Source",
                        "dependsOn": []
                      },
                      {
                        "type": "SetVariable",
                        "typeProperties": {
                          "variableName": "v_RowsRead",
                          "value": {
                            "value": "@string(activity('Copy Fabric SQLDB Source').output.rowsRead)",
                            "type": "Expression"
                          }
                        },
                        "policy": {
                          "secureInput": false,
                          "secureOutput": false
                        },
                        "name": "Set RowsRead After Copy",
                        "dependsOn": [
                          {
                            "activity": "Copy Fabric SQLDB Source",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "SetVariable",
                        "typeProperties": {
                          "variableName": "v_RowsWritten",
                          "value": {
                            "value": "@string(activity('Copy Fabric SQLDB Source').output.rowsRead)",
                            "type": "Expression"
                          }
                        },
                        "policy": {
                          "secureInput": false,
                          "secureOutput": false
                        },
                        "name": "Set RowsWritten after Copy",
                        "dependsOn": [
                          {
                            "activity": "Set RowsRead After Copy",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                "defaultActivities": []
              },
              "name": "Switch Source Tech Type",
              "description": "This will switch to different connection based on the metadata returned - Oracle, SQL, MYSQL etc",
              "dependsOn": [
                {
                  "activity": "Check Processing Method",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Lookup",
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderQuery": {
                    "value": "@if(equals(item().PROCESSING_METHOD, 'INCREMENTAL'), concat('SELECT MAX(', item().WATERMARK_COLUMN, ') AS NewWatermark FROM ', item().SOURCE_ENTITY_NAME), 'SELECT CAST(NULL AS VARCHAR(50)) AS NewWatermark')",
                    "type": "Expression"
                  },
                  "partitionOption": "None",
                  "queryTimeout": "02:00:00"
                },
                "datasetSettings": {
                  "type": "FabricSqlDatabaseTable",
                  "schema": [],
                  "connectionSettings": {
                    "name": "3a456dd5_c0c7_49b0_8fdd_f63d2db05572",
                    "properties": {
                      "type": "FabricSqlDatabase",
                      "typeProperties": {
                        "artifactId": "@item().SOURCE_SQLDATABASE_ID",
                        "workspaceId": "@item().SOURCE_WORKSPACE_ID"
                      },
                      "externalReferences": {
                        "connection": "@item().SOURCE_FABRIC_CONNECTION_ID"
                      },
                      "annotations": []
                    }
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Get New Watermark",
              "dependsOn": [
                {
                  "activity": "Switch Source Tech Type",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "EXEC [DBO].[spComplete_Ingestion_Log]\n       @META_INGESTION_LOG_ID = @META_INGESTION_LOG_ID,\n       @Status = @Status,\n       @RowsRead = @RowsRead,\n       @RowsWritten = @RowsWritten,\n       @WatermarkValueUsed = @WatermarkValueUsed,\n       @WatermarkValueNew = @WatermarkValueNew",
                      "type": "Expression"
                    },
                    "type": "NonQuery",
                    "parameters": [
                      {
                        "name": "META_INGESTION_LOG_ID",
                        "type": "Int64",
                        "value": {
                          "value": "@activity('Start Log').output.outputParameters.META_INGESTION_LOG_ID",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "Status",
                        "type": "String",
                        "value": "SUCCESS ",
                        "direction": "Input"
                      },
                      {
                        "name": "RowsRead",
                        "type": "Int64",
                        "value": {
                          "value": "@variables('v_RowsRead')",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "RowsWritten",
                        "type": "Int64",
                        "value": {
                          "value": "@variables('v_RowsWritten')",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "WatermarkValueUsed",
                        "type": "String",
                        "value": {
                          "value": "@variables('v_WatermarkUsed')",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "WatermarkValueNew",
                        "type": "String",
                        "value": {
                          "value": "@activity('Get New Watermark').output.firstRow.NewWatermark",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      }
                    ]
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "connectionSettings": {
                "name": "IngestXcel",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "a7797e2d-0b78-b1bc-4619-19ad5a9b3e80",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "5dc75a5f-3c6d-4cb4-a905-a8c7540e5e89"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Complete Log Success",
              "dependsOn": [
                {
                  "activity": "Get New Watermark",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "EXEC [DBO].[spComplete_Ingestion_Log]\n       @META_INGESTION_LOG_ID =    @META_INGESTION_LOG_ID,\n       @Status = @Status,\n@ErrorMessage=@ErrorMessage\n",
                      "type": "Expression"
                    },
                    "type": "NonQuery",
                    "parameters": [
                      {
                        "name": "META_INGESTION_LOG_ID",
                        "type": "Int64",
                        "value": {
                          "value": "@activity('Start Log').output.outputParameters.META_INGESTION_LOG_ID",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      },
                      {
                        "name": "Status",
                        "type": "String",
                        "value": "FAILED ",
                        "direction": "Input"
                      },
                      {
                        "name": "ErrorMessage",
                        "type": "String",
                        "value": {
                          "value": "@activity('Switch Source Tech Type').Error.Message",
                          "type": "Expression"
                        },
                        "direction": "Input"
                      }
                    ]
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "connectionSettings": {
                "name": "IngestXcel",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "a7797e2d-0b78-b1bc-4619-19ad5a9b3e80",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "5dc75a5f-3c6d-4cb4-a905-a8c7540e5e89"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Complete Log Failure",
              "dependsOn": [
                {
                  "activity": "Switch Source Tech Type",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ]
            },
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "v_WatermarkUsed",
                "value": "''"
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Reset Watermark Used",
              "dependsOn": [
                {
                  "activity": "Start Log",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ]
        },
        "name": "For Each Bronze Entity",
        "dependsOn": [
          {
            "activity": "Get Bronze Batch",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "TriggerName": {
        "type": "string",
        "defaultValue": "TRG_BRONZE_LOAD_DAILY"
      }
    },
    "variables": {
      "PipelineStartTime": {
        "type": "String",
        "defaultValue": "@utcNow()"
      },
      "v_RowsRead": {
        "type": "String"
      },
      "v_RowsWritten": {
        "type": "String"
      },
      "v_WatermarkUsed": {
        "type": "String"
      }
    }
  }
}