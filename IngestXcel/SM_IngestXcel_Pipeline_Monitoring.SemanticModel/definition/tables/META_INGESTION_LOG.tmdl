table META_INGESTION_LOG
	lineageTag: dde92e1d-a7ba-483c-bf12-743ec7bee1e2
	sourceLineageTag: [dbo].[META_INGESTION_LOG]

	measure 'Total Runs' = COUNTROWS(META_INGESTION_LOG)
		formatString: 0
		lineageTag: 77ba833d-193f-4060-bf73-21c684715e9b

		changedProperty = Name

	measure 'Successful Runs' = CALCULATE([Total Runs], META_INGESTION_LOG[RUN_STATUS] = "SUCCESS")
		formatString: 0
		lineageTag: f6ff7444-ae90-44f1-905d-233ead1c7aa7

		changedProperty = Name

	measure 'Running Now' = CALCULATE([Total Runs], META_INGESTION_LOG[RUN_STATUS] = "RUNNING")
		formatString: 0
		lineageTag: 3a266c31-1804-4412-9772-76ff5a3b2180

		changedProperty = Name

	measure 'Skipped Runs' = CALCULATE([Total Runs], META_INGESTION_LOG[RUN_STATUS] = "SKIPPED")
		formatString: 0
		lineageTag: b24bae70-41f5-4bc3-896c-ca0ce0b5e13a

		changedProperty = Name

	measure 'Failed Runs' = CALCULATE([Total Runs], META_INGESTION_LOG[RUN_STATUS] = "FAILED")
		formatString: 0
		lineageTag: a60ba398-ce98-4617-9fce-299db929ca42

		changedProperty = Name

	measure 'Success Rate %' =
			
			DIVIDE(
			    [Successful Runs],
			    [Successful Runs] + [Failed Runs]
			)
		lineageTag: d7fe8283-9685-48de-a96a-33937e68bf1d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Rows Written' = SUM(META_INGESTION_LOG[ROWS_WRITTEN])
		formatString: 0
		lineageTag: a52dd44c-d5f6-4035-9b42-4ade563810d8

		changedProperty = Name

	measure 'Total Rows Rejected' = SUM(META_INGESTION_LOG[ROWS_REJECTED])
		formatString: 0
		lineageTag: c860dc3d-4e3c-48f9-ae7c-9a5f31ae0295

		changedProperty = Name

	measure 'Avg Duration (min)' =
			
			AVERAGEX(
			    FILTER(META_INGESTION_LOG, NOT ISBLANK(META_INGESTION_LOG[RUN_END_DT])),
			    DATEDIFF(META_INGESTION_LOG[RUN_START_DT], META_INGESTION_LOG[RUN_END_DT], MINUTE)
			)
		lineageTag: bddcbbb6-68d8-4c6f-8b62-90043614e7b6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Rows Read' = SUM(META_INGESTION_LOG[ROWS_READ])
		formatString: 0
		lineageTag: 48167f39-2e92-4557-ab87-fa03061c217c

		changedProperty = Name

